# --- Majburiy (Railway → Variables) ---

# BotFather bergan token
BOT_TOKEN=

# Railway domeni, oxirida / siz: https://thumbnail-kitchen-production.up.railway.app
APP_URL=

# Railway Postgres: Variables'da ${{Postgres.DATABASE_URL}} deb havola qiling
DATABASE_URL=

# Adminlarning Telegram ID'lari, vergul bilan
ADMIN_IDS=

# Guruh ID'si (manfiy son, masalan -1001234567890) — tag qo'yish va yangi a'zolarni kutib olish uchun
GROUP_CHAT_ID=

# Webhook himoyasi: istalgan uzun tasodifiy satr (openssl rand -hex 32)
WEBHOOK_SECRET=

NODE_ENV=production

# --- Ixtiyoriy ---

# Guruhdagi "Ro'yxatdan o'tish" tugmasi uchun Mini App havolasi: https://t.me/<bot_username>/<app_short_name>
MINIAPP_LINK=

# "Homiy bo'lish" va "Sahna orti ariza" tugmalari
SPONSOR_URL=https://t.me/khasanov_jasurbek
SAHNA_SUBMIT_URL=

# --- Faqat lokal ishlab chiqish (prodda YOZMANG) ---
# Telegram'siz brauzerda shu ID bilan kirilgan hisoblanadi
# DEV_USER_ID=1000
